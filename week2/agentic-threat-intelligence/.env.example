# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# ChromaDB (local persistent store, no server needed by default)
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_COLLECTION_ATTACK=attack_techniques
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Neo4j (run via Docker - see INSTALLATION_GUIDE.md)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# MITRE ATT&CK
ATTACK_DATA_PATH=./data/attack_data/enterprise_attack.json

# Telemetry
RAW_LOGS_DIR=./data/raw_logs
SAMPLE_EVENTS_DIR=./data/sample_events

# Reporting
REPORTS_OUTPUT_DIR=./reports/generated_reports
